# gpsd-mqtt environment file.
#
# Copy to /etc/default/gpsd-mqtt (root:root, chmod 0600 — it holds the MQTT
# password) for the bundled systemd unit, or `source` it before running
# `gpsd-mqtt` by hand. Every value here has a sensible default; uncomment only
# what you need to change.

# ---- gpsd ------------------------------------------------------------------
# Host/port of the gpsd you want to read. gpsd must be reachable over TCP:
# start it with `-G` (listen on all interfaces) or point this at 127.0.0.1 if
# the bridge runs on the same host as gpsd.
#GPSD_HOST=127.0.0.1
#GPSD_PORT=2947

# ---- MQTT broker -----------------------------------------------------------
MQTT_HOST=127.0.0.1
#MQTT_PORT=1883
#MQTT_USERNAME=gps
#MQTT_PASSWORD=changeme
#MQTT_TLS=false
#MQTT_CA_CERT=/etc/ssl/certs/ca-certificates.crt
#MQTT_CLIENT_ID=gpsd-mqtt

# ---- Home Assistant discovery ----------------------------------------------
# HA's MQTT discovery prefix (default "homeassistant").
#HA_DISCOVERY_PREFIX=homeassistant
# Base topic for state/availability messages.
#GPSD_MQTT_TOPIC_BASE=gpsd
# Stable device id (HA groups entities by this). Defaults to gpsd_<hostname>.
#GPSD_MQTT_DEVICE_ID=gpsd_myhost
# Friendly device name shown in HA.
#GPSD_MQTT_DEVICE_NAME=GPS (gpsd)
# Device manufacturer/model shown in HA. Match an existing device's values if
# you set GPSD_MQTT_DEVICE_ID to merge onto a device another integration made.
#GPSD_MQTT_DEVICE_MANUFACTURER=gpsd
#GPSD_MQTT_DEVICE_MODEL=gpsd MQTT bridge

# ---- behaviour -------------------------------------------------------------
# Minimum seconds between state publishes (fix-mode changes publish instantly).
#GPSD_MQTT_INTERVAL=2.0
# HA marks entities unavailable if no update within this many seconds.
#GPSD_MQTT_EXPIRE_AFTER=120
#GPSD_MQTT_LOG_LEVEL=INFO
